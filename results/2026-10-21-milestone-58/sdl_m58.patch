 static struct SDL_PrivateAudioData XSDKAUD_hidden;
 
+// m58: xsdk milestone 58 step 1's counters (xsdk:docs/scope/58-audio.md), from the first frame SDL queues, for a
+// window at a time: XSDKAUD_M58Log logs them and starts them again.
+// The time base's 49.875 MHz (xsdk:docs/HARDWARE.md, "The time base runs at 49.875 MHz").
+#define XSDKAUD_M58_TICKS_PER_MS 49875
+
+static struct
+{
+    Uint32 callbacks;
+    Uint32 silent;
+    Uint32 fewest_queued;
+    // When the kernel took frame n, at n % XSDKAUD_RING.
+    Uint32 taken_tick[XSDKAUD_RING];
+    Uint32 refills;
+    Uint32 refill_ticks;
+    Uint32 refill_max;
+    Uint32 delays;
+    Uint32 delay_ticks;
+    Uint32 delay_max;
+    Uint32 clipped;
+    Uint32 hardware_threads;
+} XSDKAUD_m58 = { .fewest_queued = 0xFFFFFFFF };
+
+void XSDKAUD_M58Log(void);
+
+static Uint32 XSDKAUD_M58Ticks(void)
+{
+    Uint32 ticks;
+    __asm__ volatile("mftb %0" : "=r"(ticks));
+    return ticks;
+}
+
+static void XSDKAUD_M58Max(Uint32 *max, Uint32 value)
+{
+    Uint32 old = __atomic_load_n(max, __ATOMIC_RELAXED);
+    while (value > old && !__atomic_compare_exchange_n(max, &old, value, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+    }
+}
+
+static void XSDKAUD_M58Min(Uint32 *min, Uint32 value)
+{
+    Uint32 old = __atomic_load_n(min, __ATOMIC_RELAXED);
+    while (value < old && !__atomic_compare_exchange_n(min, &old, value, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+    }
+}
+
+static void XSDKAUD_M58Time(Uint32 *count, Uint32 *ticks, Uint32 *max, Uint32 took)
+{
+    __atomic_fetch_add(count, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(ticks, took, __ATOMIC_RELAXED);
+    XSDKAUD_M58Max(max, took);
+}
+
+static unsigned XSDKAUD_M58Us(Uint32 ticks)
+{
+    return (unsigned)((Uint64)ticks * 1000 / XSDKAUD_M58_TICKS_PER_MS);
+}
+
+// Dusklight calls it once a window, right after its frame rate.
+void XSDKAUD_M58Log(void)
+{
+    const Uint32 callbacks = __atomic_exchange_n(&XSDKAUD_m58.callbacks, 0, __ATOMIC_RELAXED);
+    const Uint32 silent = __atomic_exchange_n(&XSDKAUD_m58.silent, 0, __ATOMIC_RELAXED);
+    const Uint32 fewest = __atomic_exchange_n(&XSDKAUD_m58.fewest_queued, 0xFFFFFFFF, __ATOMIC_RELAXED);
+    const Uint32 refills = __atomic_exchange_n(&XSDKAUD_m58.refills, 0, __ATOMIC_RELAXED);
+    const Uint32 refill_ticks = __atomic_exchange_n(&XSDKAUD_m58.refill_ticks, 0, __ATOMIC_RELAXED);
+    const Uint32 refill_max = __atomic_exchange_n(&XSDKAUD_m58.refill_max, 0, __ATOMIC_RELAXED);
+    const Uint32 delays = __atomic_exchange_n(&XSDKAUD_m58.delays, 0, __ATOMIC_RELAXED);
+    const Uint32 delay_ticks = __atomic_exchange_n(&XSDKAUD_m58.delay_ticks, 0, __ATOMIC_RELAXED);
+    const Uint32 delay_max = __atomic_exchange_n(&XSDKAUD_m58.delay_max, 0, __ATOMIC_RELAXED);
+    const Uint32 clipped = __atomic_exchange_n(&XSDKAUD_m58.clipped, 0, __ATOMIC_RELAXED);
+    const Uint32 hardware_threads = __atomic_exchange_n(&XSDKAUD_m58.hardware_threads, 0, __ATOMIC_RELAXED);
+    xsdk_log_write("audio sdl: %u callbacks, %u silent, %u queued at the fewest; %u refills, %u us after the slot "
+                   "freed on average, %u at most; %u 1 ms delays, %u us on average, %u at most; %u samples past 1.0; "
+                   "the device thread on hardware threads %02X",
+                   (unsigned)callbacks, (unsigned)silent, callbacks ? (unsigned)fewest : 0, (unsigned)refills,
+                   refills ? XSDKAUD_M58Us(refill_ticks / refills) : 0, XSDKAUD_M58Us(refill_max), (unsigned)delays,
+                   delays ? XSDKAUD_M58Us(delay_ticks / delays) : 0, XSDKAUD_M58Us(delay_max), (unsigned)clipped,
+                   (unsigned)hardware_threads);
+}
+
