 using namespace dusk::audio;
 
+// m58: xsdk milestone 58 step 1's timings (xsdk:docs/scope/58-audio.md), a window at a time, logged after the frame
+// rate with SDL-xenon's driver's counters.
+extern "C" void XSDKAUD_M58Log(void);
+
+namespace {
+
+// The time base's 49.875 MHz (xsdk:docs/HARDWARE.md, "The time base runs at 49.875 MHz").
+constexpr u32 M58TicksPerMs = 49875;
+
+u32 M58Ticks() {
+    u32 ticks;
+    __asm__ volatile("mftb %0" : "=r"(ticks));
+    return ticks;
+}
+
+struct M58Timing {
+    std::atomic<u32> count{0};
+    std::atomic<u32> ticks{0};
+    std::atomic<u32> max{0};
+
+    void add(u32 took) {
+        count.fetch_add(1, std::memory_order_relaxed);
+        ticks.fetch_add(took, std::memory_order_relaxed);
+        u32 old = max.load(std::memory_order_relaxed);
+        while (took > old && !max.compare_exchange_weak(old, took, std::memory_order_relaxed)) {
+        }
+    }
+
+    // count, average us, most us, and starts again.
+    void take(unsigned out[3]) {
+        const u32 n = count.exchange(0, std::memory_order_relaxed);
+        const u32 total = ticks.exchange(0, std::memory_order_relaxed);
+        const u32 most = max.exchange(0, std::memory_order_relaxed);
+        out[0] = n;
+        out[1] = n ? static_cast<unsigned>(static_cast<uint64_t>(total / n) * 1000 / M58TicksPerMs) : 0;
+        out[2] = static_cast<unsigned>(static_cast<uint64_t>(most) * 1000 / M58TicksPerMs);
+    }
+};
+
+M58Timing M58Calls;
+M58Timing M58Subframes;
+M58Timing M58MutexWaits;
+
+}  // namespace
+
+namespace dusk::audio {
+// Called by dusk::xenon_run once a window.
+void LogM58Window();
+}  // namespace dusk::audio
+
+void dusk::audio::LogM58Window() {
+    // borealis writes the frame rate through stdio; this keeps these lines after it.
+    std::fflush(stdout);
+    XSDKAUD_M58Log();
+    unsigned calls[3], subframes[3], waits[3];
+    M58Calls.take(calls);
+    M58Subframes.take(subframes);
+    M58MutexWaits.take(waits);
+    xsdk_log_write("audio dusk: %u GetNewAudio, %u us on average, %u at most; %u subframes, %u us on average, %u at "
+                   "most; %u JAS mutex waits, %u us on average, %u at most",
+        calls[0], calls[1], calls[2], subframes[0], subframes[1], subframes[2], waits[0], waits[1], waits[2]);
+}
+
 static OutputSubframe OutBuffer;
 static std::array<f32, DSP_SUBFRAME_SIZE * OutputSubframe::NUM_CHANNELS> OutInterleaveBufferFull;
 
