+#ifdef XSDK_FAST3D_TEXTURE_DIAG
+// DIAG: the texture cache's lookups and misses in a 10 s window, logged by gfx_xsdk's window line.
+static std::unordered_map<TextureCacheKey, uint32_t, TextureCacheKey::Hasher> sDiagMisses;
+static uint32_t sDiagLookups, sDiagEvictions;
+static size_t sDiagCacheSize;
+void XsdkTextureDiagLog() {
+    uint32_t misses = 0, repeated = 0, repeatedMisses = 0;
+    std::vector<std::pair<uint32_t, TextureCacheKey>> top;
+    for (const auto& [key, count] : sDiagMisses) {
+        misses += count;
+        if (count > 1) {
+            repeated++;
+            repeatedMisses += count;
+        }
+        top.push_back({ count, key });
+    }
+    std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+    xsdk_log_write("texdiag: %u lookups, %u misses of %u keys (%u keys missed more than once, %u of the misses), "
+                   "%u evictions, %u in the cache",
+                   (unsigned)sDiagLookups, (unsigned)misses, (unsigned)sDiagMisses.size(), (unsigned)repeated,
+                   (unsigned)repeatedMisses, (unsigned)sDiagEvictions, (unsigned)sDiagCacheSize);
+    for (size_t k = 0; k < top.size() && k < 8; k++) {
+        const TextureCacheKey& key = top[k].second;
+        xsdk_log_write("texdiag:   %u misses: addr %p palettes %p %p fmt %u siz %u palette %u bytes %u",
+                       (unsigned)top[k].first, key.texture_addr, key.palette_addrs[0], key.palette_addrs[1],
+                       (unsigned)key.fmt, (unsigned)key.siz, (unsigned)key.palette_index, (unsigned)key.size_bytes);
+    }
+    // Keys missed once each: how many distinct addresses and palettes they have.
+    std::unordered_map<const uint8_t*, uint32_t> addrs, palettes;
+    for (const auto& [key, count] : sDiagMisses) {
+        if (count == 1) {
+            addrs[key.texture_addr]++;
+            palettes[key.palette_addrs[0]]++;
+        }
+    }
+    xsdk_log_write("texdiag: keys missed once: %u addresses, %u first palettes", (unsigned)addrs.size(),
+                   (unsigned)palettes.size());
+    sDiagMisses.clear();
+    sDiagLookups = sDiagEvictions = 0;
+}
+#endif
