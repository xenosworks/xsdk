+} // namespace Ship
+#include "xsdk/log.h"
+namespace Ship {
+// DIAG: a 10 s window of the game's audio frames: how many, the samples they made against those a second plays, and
+// how often the queue had run dry or was too full to take them.
+static uint32_t sDiagStart, sDiagPlays, sDiagEmpty, sDiagDropped, sDiagMin = 1u << 30;
+static uint64_t sDiagSamples;
+#endif
+
 void SDLAudioPlayer::Play(const uint8_t* buf, size_t len) {
+#ifdef XSDK_AUDIO_DIAG
+    const int buffered = Buffered();
+    const uint32_t now = SDL_GetTicks();
+    if (sDiagStart == 0) {
+        sDiagStart = now;
+    }
+    sDiagPlays++;
+    sDiagEmpty += buffered == 0;
+    sDiagMin = std::min<uint32_t>(sDiagMin, (uint32_t)buffered);
+    if (buffered < 6000) {
+        sDiagSamples += len / (sizeof(int16_t) * mNumChannels);
+    } else {
+        sDiagDropped++;
+    }
+    if (now - sDiagStart >= 10000) {
+        const double seconds = (now - sDiagStart) / 1000.0;
+        xsdk_log_write("audiodiag: %u frames in %.1f s (%.1f a second), %.0f samples a second of %d played, "
+                       "%u found the queue empty, %u samples queued at the lowest before one, %u dropped as too much",
+                       (unsigned)sDiagPlays, seconds, sDiagPlays / seconds, sDiagSamples / seconds,
+                       (int)GetSampleRate(), (unsigned)sDiagEmpty, (unsigned)sDiagMin, (unsigned)sDiagDropped);
+        sDiagStart = now;
+        sDiagPlays = sDiagEmpty = sDiagDropped = 0;
+        sDiagMin = 1u << 30;
+        sDiagSamples = 0;
+    }
+#endif
     if (Buffered() < 6000) {
         // Don't fill the audio buffer too much in case this happens
         SDL_QueueAudio(mDevice, buf, len);
