diff --git a/src/port/Game.cpp b/src/port/Game.cpp
index ef7894be..b9bf99b7 100644
--- a/src/port/Game.cpp
+++ b/src/port/Game.cpp
@@ -13,20 +13,101 @@ extern "C" {
     void AudioThread_CreateTask();
 }
 
+#define XSDK_FRAME_DIAG 1 // DIAG, not to commit
+#ifdef XSDK_FRAME_DIAG
+#include "xsdk/log.h"
+#include <atomic>
+// DIAG: a 10 s window of game updates: the game's own work, its drawing and present, and the audio thread's, each's
+// average and longest, in ms.
+static uint32_t DiagTicks() {
+    uint32_t ticks;
+    __asm__ volatile("mftb %0" : "=r"(ticks));
+    return ticks;
+}
+struct DiagPart {
+    uint64_t sum;
+    uint32_t most;
+    void Add(uint32_t ticks) {
+        sum += ticks;
+        most = ticks > most ? ticks : most;
+    }
+};
+static DiagPart sDiagGame, sDiagDraw, sDiagAudio, sDiagWhole;
+static uint32_t sDiagUpdates, sDiagStart, sDiagOver;
+static uint32_t sDiagDrawTicks;
+// The resources made in an update, any thread's, and the time the outermost took (lus ResourceManager.cpp's DIAG).
+namespace Ship {
+extern std::atomic<uint64_t> gLoadDiagCount;
+extern std::atomic<uint64_t> gLoadDiagUs;
+}
+static uint64_t sDiagLoads, sDiagLoadUs, sDiagMostLoadUs, sDiagMostLoads;
+#endif
+
 extern "C"
 void Graphics_PushFrame(Gfx* data) {
+#ifdef XSDK_FRAME_DIAG
+    const uint32_t start = DiagTicks();
+#endif
     GameEngine::ProcessGfxCommands(data);
+#ifdef XSDK_FRAME_DIAG
+    sDiagDrawTicks += DiagTicks() - start;
+#endif
 }
 
 extern "C" void Timer_Update();
 
 void push_frame() {
+#ifdef XSDK_FRAME_DIAG
+    const uint32_t start = DiagTicks();
+    sDiagDrawTicks = 0;
+    const uint64_t loads_before = Ship::gLoadDiagCount;
+    const uint64_t load_us_before = Ship::gLoadDiagUs;
+#endif
     Graphics_ThreadUpdate();
+#ifdef XSDK_FRAME_DIAG
+    const uint32_t updated = DiagTicks();
+#endif
     GameEngine::StartAudioFrame();
     GameEngine::Instance->StartFrame();
     Timer_Update();
     // thread5_iteration();
     GameEngine::EndAudioFrame();
+#ifdef XSDK_FRAME_DIAG
+    const uint32_t end = DiagTicks();
+    constexpr double TICKS_PER_MS = 49875.0;
+    sDiagDraw.Add(sDiagDrawTicks);
+    sDiagGame.Add(updated - start - sDiagDrawTicks);
+    sDiagAudio.Add(end - updated);
+    sDiagWhole.Add(end - start);
+    sDiagOver += end - start > 33.4 * TICKS_PER_MS;
+    const uint64_t loads = Ship::gLoadDiagCount - loads_before;
+    const uint64_t load_us = Ship::gLoadDiagUs - load_us_before;
+    sDiagLoads += loads;
+    sDiagLoadUs += load_us;
+    if (load_us > sDiagMostLoadUs) {
+        sDiagMostLoadUs = load_us;
+        sDiagMostLoads = loads;
+    }
+    sDiagUpdates++;
+    if (sDiagStart == 0) {
+        sDiagStart = start;
+    }
+    if (end - sDiagStart >= 10 * 1000 * TICKS_PER_MS) {
+        auto avg = [](const DiagPart& p) { return sDiagUpdates ? p.sum / TICKS_PER_MS / sDiagUpdates : 0.0; };
+        auto most = [](const DiagPart& p) { return p.most / TICKS_PER_MS; };
+        xsdk_log_write("framediag: %u updates, %u over 33.4 ms; ms each, average and longest: the game %.2f %.2f, "
+                       "drawing and present %.2f %.2f, audio %.2f %.2f, the whole %.2f %.2f; %llu resources made in "
+                       "%.1f ms, the most in an update %.1f ms for %llu",
+                       (unsigned)sDiagUpdates, (unsigned)sDiagOver, avg(sDiagGame), most(sDiagGame), avg(sDiagDraw),
+                       most(sDiagDraw), avg(sDiagAudio), most(sDiagAudio), avg(sDiagWhole), most(sDiagWhole),
+                       (unsigned long long)sDiagLoads, sDiagLoadUs / 1000.0, sDiagMostLoadUs / 1000.0,
+                       (unsigned long long)sDiagMostLoads);
+        sDiagLoads = sDiagLoadUs = sDiagMostLoadUs = sDiagMostLoads = 0;
+        sDiagGame = sDiagDraw = sDiagAudio = sDiagWhole = {};
+        sDiagUpdates = sDiagOver = 0;
+        sDiagStart = end;
+    }
+#endif
 }
 
 #ifdef _WIN32
